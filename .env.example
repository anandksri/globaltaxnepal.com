# PostgreSQL connection. Use a private, least-privilege database account.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Generate a random secret with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-value-of-at-least-32-characters"

# Used only by `npm run db:seed`; password must be 12–72 characters and at most 72 UTF-8 bytes.
# These variables are not used for public registration.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Optional public enquiry API override. If omitted, the current verified endpoint is used.
NEXT_PUBLIC_API_URL=""
