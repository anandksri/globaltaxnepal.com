# PostgreSQL connection. Use a private, least-privilege database account.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Generate a random secret with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-value-of-at-least-32-characters"

# Used only by `npm run db:seed`; password must be 11–72 characters and at most 72 UTF-8 bytes.
# These variables are not used for public registration.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Gmail SMTP delivery for enquiries, sign-in codes and password resets. Use an App Password for Gmail.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
EMAIL_DELIVERY_MODE="smtp"
# Optional: send every admin login code to this inbox instead of the user's email.
ADMIN_2FA_EMAIL="globaltaxnepal@gmail.com"
CONTACT_EMAIL="globaltaxnepal@gmail.com"
# Enquiries are stored in the dashboard even if email delivery fails.

# Canonical public origin used in password reset and staff invitation links.
NEXT_PUBLIC_SITE_URL="https://globaltaxnepal.com"

# Optional public enquiry API override. If omitted, the current verified endpoint is used.
NEXT_PUBLIC_API_URL=""

# Private document storage directory; keep outside `public` and persist it across deployments.
DOCUMENT_STORAGE_PATH="/var/lib/globaltaxnepal/documents"
